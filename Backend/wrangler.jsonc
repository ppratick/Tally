// Public template. Copy to wrangler.local.jsonc and configure your own account.
{
  "name": "tally-api",
  "main": "src/index.ts",
  "compatibility_date": "2026-11-09",
  "workers_dev": true,
  "preview_urls": false,
  "observability": {
    "enabled": false
  },
  "vars": {
    "PLAID_ENV": "sandbox",
    "TRANSACTIONS_REFRESH_ENABLED": "false",
    "PUBLIC_URL": "https://your-worker.your-subdomain.workers.dev",
    "HISTORY_TIME_ZONE": "America/New_York",
    "OPENAI_MODEL": "gpt-6-luna",
    "AI_DAILY_MESSAGE_LIMIT": "100"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "tally",
      "database_id": "00000000-0000-0000-0000-000000000000"
    }
  ],
  "triggers": {
    "crons": [
      "* * * * *"
    ]
  }
}
